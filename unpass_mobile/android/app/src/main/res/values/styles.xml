<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while Flutter starts, in UN PASS navy so there is no white flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/un_navy</item>
        <item name="android:statusBarColor">@color/un_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@color/un_dark_blue</item>
    </style>
</resources>
