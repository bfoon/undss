# UN PASS — NES configuration
#
# Copy to un_security_system/.env (next to manage.py) and fill in.
# .env is git-ignored and docker-ignored: it never enters the repository or
# the image. Anything left blank falls back to the default in settings.py.
#
# Certificates and the policy PDF do NOT go here. They go in ./secrets/ at
# the project root, which docker-compose mounts read-only at /etc/unpass.

# ── Office seal (PAdES) ─────────────────────────────────────────────────
# Sealing switches on by itself once ./secrets/seal.p12 exists.
# Test certificate only (Adobe will not trust it):
#   docker compose exec web python manage.py esign_pades \
#       --make-dev-cert /app/secrets/seal.p12 --dev-cert-passphrase '...'
#   docker compose restart web
# (/etc/unpass is read-only inside the container; /app/secrets is the same
#  host folder, writable, which is why the command writes there.)
ESIGN_PADES_PKCS12_PASSPHRASE=

# Shown in a reader's signature panel, e.g.  <city>, <country>
ESIGN_PADES_LOCATION=

# Defaults to DigiCert (free, root trusted by Adobe). Replace with the
# corporate TSA if UNDP / Regional Bureau ICT provide one.
# ESIGN_PADES_TSA_URL=http://timestamp.digicert.com
# ESIGN_PADES_TSA_USERNAME=
# ESIGN_PADES_TSA_PASSWORD=

# b-b | b-t | b-lt | b-lta  (steps down automatically; records what it got)
# ESIGN_PADES_LEVEL=b-lta

# Force sealing on or off regardless of whether seal.p12 exists:
# ESIGN_PADES_ENABLED=1

# ── Signature policy ────────────────────────────────────────────────────
# Leave empty until the office owns an OID arc. Never invent one.
# When set, put the policy PDF at ./secrets/nes-signature-policy-v1.pdf
# and publish the same file at <SITE_URL>/policies/nes-signature-policy-v1.pdf
ESIGN_PADES_POLICY_OID=

# ── Signing identities — SET BEFORE ANYONE ENROLS, NEVER CHANGE AFTER ───
# Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, IDs fall back to SECRET_KEY, which is committed to the repo.
ESIGN_SIGNATURE_ID_SECRET=

# Turn on once staff have enrolled their personal keys:
ESIGN_REQUIRE_ATTESTATION=0

# ── Cross-office witnessing ─────────────────────────────────────────────
# Witnessing switches on by itself once this is set. Choose it once and
# keep it: it is written into signed statements, e.g. UNDSS-GM
ESIGN_WITNESS_OFFICE_CODE=

# Who is emailed when a document disagrees with its witnesses (comma list).
ESIGN_WITNESS_ALERT_EMAILS=

# ── Archival format (PDF/A) ─────────────────────────────────────────────
# On by default. For a formal ISO 19005 verdict, install veraPDF and set:
# ESIGN_PDFA_VERAPDF=/opt/verapdf/verapdf
# ESIGN_PDFA_ENABLED=1

# ── Public address, used in links written into documents ───────────────
SITE_URL=https://unpass.gm
